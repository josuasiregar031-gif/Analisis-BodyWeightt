var data = [];

/* Fitur 1: membaca dataset */
function bacaDataset(teks){
  var baris = teks.replace(/\r/g,"").split("\n");
  var hasil = [];
  for (var i = 1; i < baris.length; i++){            // baris 0 = header
    var b = baris[i].trim();
    if (b === "") continue;
    var k = b.split(",");
    if (k.length < 7) continue;
    var d = {ID:k[0], JenisKelamin:k[1], Usia:parseFloat(k[2]), TinggiMeter:parseFloat(k[3]),
             BeratKg:parseFloat(k[4]), AktivitasFisik:parseFloat(k[5]), KategoriBeratBadan:k[6]};
    d.IMT = hitungIMT(d.BeratKg, d.TinggiMeter);
    hasil.push(d);
  }
  return hasil;
}

/* Fitur 3: statistik */
function hitungIMT(berat, tinggi){ return berat / (tinggi * tinggi); }
function hitungStatistik(arr){
  var tt=0, tb=0, ti=0, mx=arr[0], mn=arr[0];
  for (var i=0;i<arr.length;i++){
    tt+=arr[i].TinggiMeter; tb+=arr[i].BeratKg; ti+=arr[i].IMT;
    if (arr[i].IMT > mx.IMT) mx=arr[i];
    if (arr[i].IMT < mn.IMT) mn=arr[i];
  }
  var n=arr.length;
  return {jumlah:n, rt:tt/n, rb:tb/n, ri:ti/n, mx:mx, mn:mn};
}

/* Fitur 2: cari */
function cariID(arr, id){
  id = id.trim().toUpperCase();
  for (var i=0;i<arr.length;i++){ if (arr[i].ID.toUpperCase() === id) return arr[i]; }
  return null;
}

/* Fitur 4: pengelompokan */
function kelompokkan(arr){
  var g = {Normal_Weight:[], Insufficient_Weight:[], Overweight:[], Obesity:[]};
  var asli = {};
  for (var i=0;i<arr.length;i++){
    var d = arr[i], k = d.KategoriBeratBadan;
    if (k === "Normal_Weight") g.Normal_Weight.push(d.ID);
    else if (k === "Insufficient_Weight") g.Insufficient_Weight.push(d.ID);
    else if (k.indexOf("Overweight") === 0) g.Overweight.push(d.ID);
    else if (k.indexOf("Obesity") === 0) g.Obesity.push(d.ID);
    if (!asli[k]) asli[k] = [];
    asli[k].push({id:d.ID, imt:d.IMT});
  }
  return {g:g, asli:asli};
}

/* Fitur 5/6: laporan */
function buatLaporan(arr){
  var s = hitungStatistik(arr), r = kelompokkan(arr);
  var t = "LAPORAN ANALISIS BODY WEIGHT METRICS\n" + "=".repeat(50) + "\n";
  t += "Jumlah data              : " + s.jumlah + "\n";
  t += "Rata-rata TinggiMeter    : " + s.rt.toFixed(4) + " m\n";
  t += "Rata-rata BeratKg        : " + s.rb.toFixed(4) + " kg\n";
  t += "Rata-rata IMT            : " + s.ri.toFixed(4) + "\n";
  t += "IMT tertinggi            : " + s.mx.IMT.toFixed(4) + " (ID: " + s.mx.ID + ")\n";
  t += "IMT terendah             : " + s.mn.IMT.toFixed(4) + " (ID: " + s.mn.ID + ")\n";
  t += "\nREKAP KategoriBeratBadan\n" + "-".repeat(50) + "\n";
  for (var k in r.asli){ t += (k + " ".repeat(25)).slice(0,25) + ": " + r.asli[k].length + " data\n"; }
  return t;
}

/* tampilan */
var $ = function(id){ return document.getElementById(id); };
function kls(k){ return k==="Normal_Weight"?"k-normal":k==="Insufficient_Weight"?"k-insuf":k.indexOf("Overweight")===0?"k-over":"k-obes"; }
function pill(k){ return '<span class="pill '+kls(k)+'">'+k.replace(/_/g," ")+'</span>'; }
function f(x,n){ return x.toFixed(n); }

function render(){
  $("srcCount").textContent = data.length;
  $("dataHint").textContent = "Total data: " + data.length + " rekaman. IMT = BeratKg / (TinggiMeter ** 2).";
  var h = "";
  for (var i=0;i<data.length;i++){
    var d = data[i];
    h += "<tr><td>"+d.ID+"</td><td>"+d.JenisKelamin+"</td><td class='n'>"+f(d.Usia,2)+"</td><td class='n'>"+f(d.TinggiMeter,2)+
         "</td><td class='n'>"+f(d.BeratKg,2)+"</td><td class='n'>"+f(d.AktivitasFisik,2)+"</td><td class='n'>"+f(d.IMT,2)+"</td><td>"+pill(d.KategoriBeratBadan)+"</td></tr>";
  }
  $("tbody").innerHTML = h;

  var s = hitungStatistik(data), r = kelompokkan(data);
  $("tiles").innerHTML =
    '<div class="tile"><span>Jumlah data</span><b>'+s.jumlah+'</b></div>'+
    '<div class="tile"><span>Rata-rata tinggi</span><b>'+f(s.rt,4)+'</b><i>meter</i></div>'+
    '<div class="tile"><span>Rata-rata berat</span><b>'+f(s.rb,4)+'</b><i>kg</i></div>'+
    '<div class="tile"><span>Rata-rata IMT</span><b>'+f(s.ri,4)+'</b></div>'+
    '<div class="tile"><span>IMT tertinggi</span><b>'+f(s.mx.IMT,4)+'</b><i>ID '+s.mx.ID+'</i></div>'+
    '<div class="tile"><span>IMT terendah</span><b>'+f(s.mn.IMT,4)+'</b><i>ID '+s.mn.ID+'</i></div>';

  var order = [["Insufficient_Weight","k-insuf"],["Normal_Weight","k-normal"],["Overweight","k-over"],["Obesity","k-obes"]];
  var mxn = 1; order.forEach(function(o){ mxn = Math.max(mxn, r.g[o[0]].length); });
  $("bars").innerHTML = order.map(function(o){
    var n = r.g[o[0]].length;
    return '<div class="bar '+o[1]+'"><span style="color:var(--fg)">'+o[0].replace(/_/g," ")+'</span><div class="track"><div class="fill" style="width:'+(n/mxn*100)+'%"></div></div><em style="color:var(--fg)">'+n+'</em></div>';
  }).join("");

  $("groups").innerHTML = order.map(function(o){
    var ids = r.g[o[0]];
    return '<div class="group"><h3><span class="'+o[1]+'">'+o[0].replace(/_/g," ")+'</span><span>'+ids.length+' data</span></h3><div class="chips">'+
      ids.map(function(x){return "<span>"+x+"</span>";}).join("")+'</div></div>';
  }).join("");

  var rk = "<h2 style='font-size:.95rem'>Rekap kategori asli</h2>";
  for (var k in r.asli){
    rk += '<details><summary><span class="'+kls(k)+'">'+k.replace(/_/g," ")+'</span> · '+r.asli[k].length+' data</summary><div class="chips" style="margin-top:8px">'+
      r.asli[k].map(function(x){return "<span>"+x.id+" · IMT "+f(x.imt,2)+"</span>";}).join("")+'</div></details>';
  }
  $("rekap").innerHTML = rk;
  $("report").textContent = buatLaporan(data);
}

/* tab (menu) */
$("tabs").addEventListener("click", function(e){
  var b = e.target.closest("button"); if(!b) return;
  var t = b.getAttribute("data-t");
  var all = $("tabs").querySelectorAll("button");
  for (var i=0;i<all.length;i++){ all[i].setAttribute("aria-selected", all[i]===b ? "true":"false"); }
  ["data","cari","stat","grup","lap"].forEach(function(x){ $("p-"+x).hidden = (x!==t); });
});

/* cari ID */
$("cariForm").addEventListener("submit", function(e){
  e.preventDefault();
  var v = $("idIn").value, h = cariID(data, v);
  if (h){
    $("cariOut").innerHTML = '<div class="found">'+
      [["ID",h.ID],["Jenis kelamin",h.JenisKelamin],["Usia",f(h.Usia,2)+" tahun"],["Tinggi",f(h.TinggiMeter,2)+" m"],
       ["Berat",f(h.BeratKg,2)+" kg"],["Aktivitas fisik",f(h.AktivitasFisik,2)],["IMT",f(h.IMT,2)]]
      .map(function(p){return "<div><span>"+p[0]+"</span><b>"+p[1]+"</b></div>";}).join("")+
      '<div><span>Kategori</span>'+pill(h.KategoriBeratBadan)+'</div></div>';
  } else {
    var teks = v.trim() === "" ? "Masukkan ID terlebih dahulu." : "Data dengan ID '"+v.trim().toUpperCase().replace(/[<>&]/g,"")+"' tidak ditemukan.";
    $("cariOut").innerHTML = '<div class="msg bad">'+teks+'</div>';
  }
});

/* salin laporan */
$("copyBtn").addEventListener("click", function(){
  var teks = $("report").textContent, btn = $("copyBtn");
  function ok(){ btn.textContent = "Tersalin"; setTimeout(function(){ btn.textContent = "Salin laporan"; }, 1500); }
  function fallback(){
    var r = document.createRange(); r.selectNodeContents($("report"));
    var sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(r);
    btn.textContent = "Teks terpilih, tekan Ctrl+C";
  }
  try { navigator.clipboard.writeText(teks).then(ok, fallback); } catch(e){ fallback(); }
});

/* muat file lain */
$("fileIn").addEventListener("change", function(e){
  var fl = e.target.files[0]; if(!fl) return;
  var rd = new FileReader();
  rd.onload = function(){
    var arr = bacaDataset(String(rd.result));
    if (arr.length === 0){ $("srcName").textContent = fl.name + " (format tidak sesuai)"; return; }
    data = arr; $("srcName").textContent = fl.name; render();
  };
  rd.readAsText(fl);
});
$("fileLbl").addEventListener("keydown", function(e){ if(e.key==="Enter"||e.key===" "){ e.preventDefault(); $("fileIn").click(); }});

data = bacaDataset(CSV);
render();
</script>

</body></html>
